index 0000000..a35627d
--- /dev/null
+++ b/lib/types/components/sidePanel/companion/geminiPolicy.js
@@ -0,0 +1,96 @@
+/**
+ * The Gemini animations use the host's semantic keys and one shared
+ * elapsed-time clock for both render tracks. No timers are owned here.
+ */
+import { readFileSync } from 'node:fs';
+import { loadSpriteKit } from './deepy.js';
+
+const assets = '../../../../../assets/gemini/';
+const keys = [
+    'idle', 'idle-look', 'idle-spout', 'swim', 'thinking', 'typing', 'music', 'conducting',
+    'building', 'compacting', 'carrying', 'notification', 'error', 'happy', 'thumbs-up',
+    'sleeping', 'waking', 'poke-left', 'poke-right', 'smile-hearts', 'tickle', 'drag',
+];
+const cache = { kit: null };
+let catalog = null;
+
+export function loadGeminiCatalog() {
+    if (catalog !== null)
+        return catalog;
+    try {
+        const kit = loadSpriteKit([assets + 'frames.json'], cache, 'gemini');
+        const actions = JSON.parse(readFileSync(new URL(assets + 'actions.json', import.meta.url), 'utf8'));
+        if (kit === undefined || Object.keys(kit.byKey).length !== keys.length || Object.keys(actions).length !== keys.length)
+            throw new Error('Gemini action set is incomplete');
+        for (const key of keys) {
+            const a = kit.byKey[key], mode = actions[key];
+            if (!a?.frames.length || !a.frames.every(f => Number.isSafeInteger(f.dur) && f.dur > 0)
+                || mode?.totalMs !== a.totalMs || (mode.playback !== 'once' && mode.playback !== 'loop'))
+                throw new Error('Invalid Gemini action: ' + key);
+        }
+        catalog = { kit, actions };
+    }
+    catch {
+        // Invalid/missing letters make the actor unavailable; the choice
+        // resolver can keep the inherited skin and art without a blank slot.
+        catalog = undefined;
+    }
+    return catalog;
+}
+
+export const loadGeminiKit = () => loadGeminiCatalog()?.kit;
+export const geminiSupportsSkin = () => loadGeminiCatalog() !== undefined;
+
+export function geminiAnimationKey(semantic) {
+    if (semantic === 'look')
+        return 'idle-look';
+    if (semantic === 'notice')
+        return 'idle-spout';
+    return keys.includes(semantic) ? semantic : 'idle';
+}
+
+export function geminiFramePosition(animation, elapsed, playback) {
+    const last = animation.frames.length - 1;
+    const time = Math.max(0, elapsed);
+    if (playback === 'once' && time >= animation.totalMs)
+        return { index: last, delay: Infinity };
+    let rest = time % animation.totalMs;
+    for (const [index, frame] of animation.frames.entries()) {
+        if (rest < frame.dur)
+            return { index, delay: Math.max(1, frame.dur - rest) };
+        rest -= frame.dur;
+    }
+    return { index: last, delay: Infinity };
+}
+
+export function geminiSelectFrame(animation, elapsed) {
+    return geminiFramePosition(animation, elapsed, loadGeminiCatalog()?.actions[animation.key]?.playback).index;
+}
+
+export function geminiDelay(key, elapsed) {
+    const { kit, actions } = loadGeminiCatalog() ?? {};
+    const animation = kit?.byKey[key];
+    return animation === undefined ? Infinity : geminiFramePosition(animation, elapsed, actions[key].playback).delay;
+}
+
+export function geminiDuration(key, fallback) {
+    return loadGeminiCatalog()?.actions[key]?.totalMs ?? fallback;
+}
+
+export function geminiReaction(key, since, fallback) {
+    return { semantic: key, since, until: since + geminiDuration(key, fallback) };
+}
+
+export function geminiAdvanceReaction(reaction, now, heartsMs) {
+    if (!reaction || now < reaction.until)
+        return reaction;
+    if (reaction.semantic !== 'poke-left' && reaction.semantic !== 'poke-right')
+        return undefined;
+    const next = geminiReaction('smile-hearts', reaction.until, heartsMs);
+    return now < next.until ? next : undefined;
+}
+
+export function geminiPreemptsReaction(target, reaction) {
+    return (target === 'notification' || target === 'error' || target === 'compacting')
+        && ['poke-left', 'poke-right', 'smile-hearts', 'tickle'].includes(reaction?.semantic);
+}
